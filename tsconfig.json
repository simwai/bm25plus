{
  "extends": "@sindresorhus/tsconfig",
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "lib": ["ESNext", "DOM", "WebWorker"],
    "incremental": true,
    "isolatedModules": true
  },
  "include": ["src", "tests"]
}
